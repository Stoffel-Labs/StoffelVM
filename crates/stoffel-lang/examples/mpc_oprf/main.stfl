# Threshold BLS12-381 OPRF service.
#
# The client hashes each message to G1, blinds the point with a fresh non-zero
# scalar, and packs the compressed point into two field limbs for ClientStore.
# The nodes learn only the uniformly blinded point and evaluate it with one
# persistent threshold-shared key. The client unblinds and finalizes the
# returned point locally.
#
# This example evaluates three requests in one batch: two independently
# blinded encodings of the same message and one different message. See the
# release client in crates/stoffel-rust-sdk/examples/oprf.rs.

def main() -> bytes:
  var request_count = 3
  var limbs_per_point = 2
  var limb_payload_bytes = 24
  var point_bytes = 48

  # Generate the service key cooperatively on first use, then persist only the
  # per-node shares. Stable deployments give every node a durable, private
  # --local-store path and keep this versioned key identifier unchanged until
  # an intentional rotation.
  var key_id = "oprf:bls12-381-g1:sk:v1"
  if LocalStorage.exists(key_id):
    # Validate the persisted share envelope before loading it as a typed value.
    discard LocalStorage.load_share(key_id)
  else:
    var generated_key: secret int64 = Share.random_field()
    discard LocalStorage.store(key_id, generated_key)
  var key: secret int64 = LocalStorage.load(key_id)

  var packed: list[Share] = list(request_count * limbs_per_point)
  var limb_index = 0
  while limb_index < request_count * limbs_per_point:
    packed[limb_index] = ClientStore.take_share(0, limb_index)
    limb_index = limb_index + 1

  # The limbs encode public blinded points, so revealing them does not reveal
  # the messages. One batch reconstructs every limb.
  var opened_limbs: list[bytes] = Share.batch_open_field(packed)
  var generators: list[bytes] = list(request_count)
  var request_index = 0
  while request_index < request_count:
    var point: bytes = list(point_bytes)
    extend(point, slice(opened_limbs[request_index * limbs_per_point], 0, limb_payload_bytes))
    extend(point, slice(opened_limbs[request_index * limbs_per_point + 1], 0, limb_payload_bytes))
    generators[request_index] = point
    request_index = request_index + 1

  var keys: list[Share] = list(request_count)
  request_index = 0
  while request_index < request_count:
    keys[request_index] = key
    request_index = request_index + 1
  var evaluated: list[bytes] = Share.batch_open_exp_custom(keys, generators, "bls12-381-g1")

  var response: bytes = list(request_count * point_bytes)
  request_index = 0
  while request_index < request_count:
    extend(response, evaluated[request_index])
    request_index = request_index + 1
  return response
